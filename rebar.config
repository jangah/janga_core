{minimum_otp_vsn, "28"}.

{erl_opts, [debug_info]}.

{eunit_opts, [verbose, {report, {eunit_surefire, [{dir, "."}]}}]}.
{cover_enabled, true}.

{deps, [
    {gproc,         "1.1.0"},
    %% 0.15.0 adds OTP 28 support (not yet published to hex.pm)
    {erlydtl,       {git, "https://github.com/erlydtl/erlydtl.git", {tag, "0.15.0"}}},
    {ibrowse,       "4.4.2"},
    %% 1.1.3 adds OTP 28 CI support (not yet published to hex.pm)
    {jiffy,         {git, "https://github.com/davisp/jiffy.git", {tag, "1.1.3"}}},
    %% 1.12.0 uses mochiweb 3.x (fixes OTP 26+ `maybe` keyword conflict)
    {webmachine,    {git, "https://github.com/webmachine/webmachine.git", {tag, "1.12.0"}}},
    %% 3.3.0 adds OTP 28 CI support and fixes `maybe` keyword + ssl API deprecations
    {mochiweb,      "3.3.0"},
    {exometer_core, "2.0.0"},
    {erlib,         {git, "https://github.com/ulfa/erlib.git",       {branch, "master"}}},
    {fnotify,       {git, "https://github.com/Feuerlabs/fnotify.git", {branch, "master"}}},
    %% Override transitive dep from erlydtl (uses deprecated git:// protocol)
    {jsx, "3.1.0"}
]}.
